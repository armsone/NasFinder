#!/bin/bash

set -euo pipefail

repository_root="$(git rev-parse --show-toplevel)"

# Consume Git's ref update list before running the guard so hook input cannot
# leak into a child command. Dirty worktrees may push only the current HEAD;
# named-branch and snapshot preservation checks still apply.
set --
while read -r _local_ref _local_sha _remote_ref _remote_sha; do
    set -- "$@" "$_local_sha"
done

if [[ $# -eq 0 ]]; then
    "$repository_root/scripts/repository_guard.sh" status
else
    "$repository_root/scripts/repository_guard.sh" push "$@"
fi
